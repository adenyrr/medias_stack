TRACEARR_HOST=tracearr.example.com
TZ=Europe/Brussels
# Conserver les secrets ACTUELS de production ; ne pas les régénérer.
DB_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
BETTER_AUTH_SECRET=
# IP/CIDR de Traefik puis BunkerWeb, séparés par des virgules. Ne pas mettre *.
# Utiliser les adresses réellement vues ; tenir compte du NAT rootless.
TRUST_PROXY=
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=pki
# Noms physiques réellement montés en production ; ne pas créer de volumes.
TRACEARR_BACKUPS_VOLUME=
TRACEARR_IMAGES_VOLUME=
TIMESCALE_DATA_VOLUME=
REDIS_DATA_VOLUME=
