QBITTORRENT_HOST=qbittorrent.example.com
QUI_HOST=qui.example.com
# Réutiliser les chemins ABSOLUS existants lors de la migration.
QBITTORRENT_CONFIG=/home/deploy/appdata/qbittorrent
QUI_CONFIG=/home/deploy/appdata/qui
# Même chemin hôte et même /downloads dans les deux conteneurs.
MEDIAS=/media/medias
TZ=Europe/Brussels
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=pki
# IP LOCALE de la VM recevant BitTorrent ; choisir l'interface autorisée.
TORRENT_BIND_IP=
